<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/azul_900"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Calcula IF - Semestral"
        app:titleTextAppearance="@style/ToolbarTitleText"
        app:titleTextColor="@color/background_light" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteinerDadosNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/materialToolbar"
        app:layout_constraintStart_toStartOf="@id/scrollView2"
        app:layout_constraintEnd_toEndOf="@id/scrollView2">

        <TextView
            android:id="@+id/lgdNotaE1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Nota da E1"
            android:textColor="@color/azul_900"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lgdNotaE2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nota da E2"
            android:textColor="@color/azul_900"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/edtNotaE1"
            app:layout_constraintTop_toBottomOf="@+id/edtNotaE1" />

        <EditText
            android:id="@+id/edtNotaE1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:digits="0123456789,"
            android:ems="10"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:tooltipText="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/lgdNotaE1"
            app:layout_constraintTop_toBottomOf="@+id/lgdNotaE1" />

        <EditText
            android:id="@+id/edtNotaE2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:digits="0123456789,"
            android:ems="10"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:tooltipText="0"
            app:layout_constraintEnd_toEndOf="@+id/edtNotaE1"
            app:layout_constraintStart_toStartOf="@+id/lgdNotaE2"
            app:layout_constraintTop_toBottomOf="@+id/lgdNotaE2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcularNotas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/gradiente_round_butons_azul"
            android:backgroundTint="@null"
            android:paddingVertical="12dp"
            android:text="@string/calcular_notas"
            android:textColor="@color/background"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="@+id/edtNotaE2"
            app:layout_constraintStart_toEndOf="@+id/btnLimparCampos"
            app:layout_constraintTop_toBottomOf="@+id/edtNotaE2"
            app:strokeColor="@color/aprovado_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparCampos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/aprovado_background"
            android:fontFamily="@font/inter_regular"
            android:paddingVertical="12dp"
            android:text="@string/limpar_campos"
            android:textColor="@color/prova_final_texto"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnCalcularNotas"
            app:layout_constraintStart_toStartOf="@+id/edtNotaE2"
            app:layout_constraintTop_toTopOf="@+id/btnCalcularNotas" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/conteinerDadosNotas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

                 <androidx.cardview.widget.CardView
                    android:id="@+id/cardView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                     android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="30dp"
                    app:cardCornerRadius="20dp"
                   >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/background_info">

                        <TextView
                            android:id="@+id/textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:text="Passo a passo"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/txtMediaScreen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_marginEnd="16dp"
                            android:lineSpacingExtra="5dp"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/descricao_notas"
                            android:textColor="@color/black"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/textView"
                            app:layout_constraintTop_toBottomOf="@+id/textView" />

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Atenção: Se quiser calcular quanto precisa para passar, deixe uma das notas em branco."
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="@+id/txtMediaScreen"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="@+id/txtMediaScreen"
                            app:layout_constraintTop_toBottomOf="@+id/txtMediaScreen" />

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="(E1 * 2) + (E2 * 3)"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            app:layout_constraintEnd_toEndOf="@+id/txtStatus"
                            app:layout_constraintStart_toStartOf="@+id/txtStatus"
                            app:layout_constraintTop_toBottomOf="@+id/textView7" />

                        <TextView
                            android:id="@+id/txtNotaEtapa1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-12dp"
                            android:text="__________________________________"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            app:layout_constraintEnd_toEndOf="@+id/textView4"
                            app:layout_constraintHorizontal_bias="1.0"
                            app:layout_constraintStart_toStartOf="@+id/textView4"
                            app:layout_constraintTop_toBottomOf="@+id/textView4" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="32dp"
                            android:text="5"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/txtNotaEtapa1"
                            app:layout_constraintStart_toStartOf="@+id/textView4"
                            app:layout_constraintTop_toBottomOf="@id/txtNotaEtapa1" />

                        <TextView
                            android:id="@+id/textView7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="Fórmula:"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="@+id/txtStatus"
                            app:layout_constraintTop_toBottomOf="@+id/txtStatus" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDeseinvolvedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Thiago Tomaz"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView"
                    app:layout_constraintStart_toEndOf="@+id/imageView"
                    app:layout_constraintTop_toTopOf="@+id/imageView" />

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Desenvolvido por:"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/imageView" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:background="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/foto" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>